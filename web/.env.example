# Optional. Keep this server-side; never expose it with a NEXT_PUBLIC_ prefix.
RAILRADAR_API_KEY=

# Gemini chat (server-only). Add the key to ignored .env.local for local testing.
GEMINI_API_KEY=
# demo_session: verified RailEase login; local: development + loopback only.
# sites: trusted Sites identity + allowlist.
# Leave empty to disable access. Local mode is always rejected in production.
GEMINI_CHAT_ACCESS=local
# Required for sites mode; comma-separated platform-authenticated user IDs.
GEMINI_ALLOWED_USER_IDS=

# Server-side RailEase login. Never expose either value to the browser.
# 32 random bytes encoded as 64 lowercase hex characters.
RAIL_SESSION_SECRET=
# v1:<16-byte salt hex>:<PBKDF2-SHA256 proof hex>; see docs/gemini-chat.md.
RAIL_LOGIN_PASSWORD_VERIFIER=
